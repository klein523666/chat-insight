CHAT_INSIGHT_PORT=8080
TZ=Asia/Shanghai
COOKIE_SECURE=false
TELEGRAM_BACKFILL_HOURS=3
NAPCAT_UID=1000
NAPCAT_GID=1000
# 可选：仅在持久配置中存在多个 QQ 账号时指定。
NAPCAT_ACCOUNT=

# 正式发布镜像；源码部署也保留 build 配置。
CHAT_INSIGHT_IMAGE=ghcr.io/klein523666/chat-insight:0.1.0
TELEGRAM_IMAGE=ghcr.io/klein523666/chat-insight-telegram:0.1.0
