FROM debian:bookworm AS tdlib
ARG TDLIB_COMMIT=022d60202e446ad1287b9fb68e687c8a0760788b
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cmake g++ git gperf libssl-dev make php-cli zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN git clone --filter=blob:none https://github.com/tdlib/td.git \
    && cd td && git checkout "$TDLIB_COMMIT" \
    && php SplitSource.php \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target tdjson -j2

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TDLIB_LIBRARY=/usr/local/lib/libtdjson.so \
    TDLIB_DATA_DIR=/data/telegram
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libssl3 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 10001 chatinsight \
    && adduser --system --uid 10001 --ingroup chatinsight chatinsight \
    && mkdir -p /data/telegram /usr/local/lib \
    && chown -R chatinsight:chatinsight /data /app
COPY --from=tdlib /build/td/build/libtdjson.so /usr/local/lib/libtdjson.so
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir --no-deps .
USER chatinsight
EXPOSE 8090
CMD ["chat-insight-telegram"]
