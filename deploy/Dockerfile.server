FROM node:24-bookworm-slim AS web
WORKDIR /src/apps/web
RUN corepack enable
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web/ ./
RUN pnpm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CHAT_INSIGHT_ROOT=/app \
    CHAT_INSIGHT_WEB_DIST=/app/apps/web/dist
WORKDIR /app
RUN addgroup --system --gid 10001 chatinsight \
    && adduser --system --uid 10001 --ingroup chatinsight chatinsight \
    && mkdir -p /data/core /app/apps/web/dist \
    && chown -R chatinsight:chatinsight /data /app
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY pyproject.toml README.md alembic.ini ./
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY --from=web /src/apps/web/dist/ ./apps/web/dist/
RUN pip install --no-cache-dir --no-deps .
USER chatinsight
EXPOSE 8080
CMD ["chat-insight-server"]
